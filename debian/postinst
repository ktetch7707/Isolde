#!/bin/sh
# postinst script for isolde
#
# Sets up autostart and crash recovery for the installed user.
# Runs as root during dpkg --install / apt install.
# If run without root privileges, system-wide autostart is skipped
# and the user can enable it manually from Settings.

PREFIX="/opt/isolde"
ISOLDE_BIN="$PREFIX/bin/isolde"
WAIT_FOR_DISPLAY="$PREFIX/share/isolde/wait-for-display.py"
RECOVERY_UI="$PREFIX/bin/isolde-recovery"

# Non-root: skip system-wide installation silently.
if [ "$(id -u 2>/dev/null || echo 1)" -ne 0 ]; then
    exit 0
fi

# Root: install systemd user service units system-wide.
mkdir -p /etc/systemd/user 2>/dev/null || true

cat > /etc/systemd/user/isolde.service <<'EOF' 2>/dev/null || true
[Unit]
Description=Isolde living-room interface
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=3
OnFailure=isolde-recovery.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/isolde/share/isolde/wait-for-display.py --executable /opt/isolde/bin/isolde
Restart=always
RestartSec=5
TimeoutStopSec=10
KillMode=control-group

[Install]
WantedBy=graphical-session.target
EOF

cat > /etc/systemd/user/isolde-recovery.service <<'EOF' 2>/dev/null || true
[Unit]
Description=Isolde on-screen recovery
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/isolde/share/isolde/recovery-controller.py --prefix /opt/isolde --ui /opt/isolde/bin/isolde-recovery
Restart=no
TimeoutStopSec=5
KillMode=control-group
EOF

chmod 0644 /etc/systemd/user/isolde.service /etc/systemd/user/isolde-recovery.service 2>/dev/null || true

# System-wide autostart entry.
mkdir -p /etc/xdg/autostart 2>/dev/null || true
cat > /etc/xdg/autostart/isolde.desktop <<'EOF' 2>/dev/null || true
[Desktop Entry]
Type=Application
Name=Isolde
Comment=Media and home interface
Exec=/opt/isolde/bin/isolde
Terminal=false
X-GNOME-Autostart-enabled=true
OnlyShowIn=GNOME;Unity;XFCE;
EOF
chmod 0644 /etc/xdg/autostart/isolde.desktop 2>/dev/null || true

# Desktop application menu entry.
mkdir -p /usr/share/applications 2>/dev/null || true
cat > /usr/share/applications/org.isolde.Isolde.desktop <<'EOF' 2>/dev/null || true
[Desktop Entry]
Type=Application
Name=Isolde
Comment=Media and home interface
Exec=/opt/isolde/bin/isolde --windowed
TryExec=/opt/isolde/bin/isolde
Terminal=false
Categories=AudioVideo;Player;
EOF
chmod 0644 /usr/share/applications/org.isolde.Isolde.desktop 2>/dev/null || true

# Reload systemd so units are available.
systemctl daemon-reload 2>/dev/null || true

exit 0
