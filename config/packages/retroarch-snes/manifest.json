{
  "schemaVersion": 1,
  "packageId": "retroarch-snes",
  "version": "1.0.0",
  "minIsoldeVersion": "0.0.1.2",
  "name": "RetroArch · SNES (bsnes balanced)",
  "description": "Managed console runtime. Add your game files in Games and use Emulator setup for private settings and firmware. Compatibility and controller acceptance are tracked separately.",
  "category": "Games",
  "publisher": "Libretro and core authors",
  "provenance": "Pinned runtime; no commercial games or firmware included",
  "capabilities": [
    "desktop.external",
    "input.gamepad",
    "audio.output"
  ],
  "app": {
    "id": "retroarch-snes",
    "type": "desktop",
    "presentationMode": "game-hub",
    "networkRequirement": "none",
    "desktopId": "isolde-retroarch-snes",
    "emulatorRuntime": "retroarch-snes",
    "windowClass": "retroarch",
    "containment": "fullscreen",
    "section": "Games",
    "accent": "#397DB8",
    "symbol": "SNES",
    "handledActions": [
      "open-file"
    ],
    "actionHandlers": {
      "open-file": {
        "appendTarget": true
      }
    },
    "gameFormats": [
      "sfc",
      "smc"
    ]
  }
}
